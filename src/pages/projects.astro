---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import PageTitle from "../components/PageTitle.astro";
import ProjectTemplate from "../components/ProjectTemplate.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

type RenderedProject = {
  title: string;
  link: string;
  Content: Awaited<ReturnType<typeof render>>["Content"];
};

const projects: CollectionEntry<'projects'>[] = await getCollection("projects"); 
const renderedProjects: RenderedProject[] = await Promise.all(
  projects.map(async (project) => {
    const { Content } = await render(project);
    return {
      title: project.data.title,
      link: project.data.link,
      Content,
    };
  })
);
---

<BaseLayout title="Projects" description="Michael Zhan's projects">
  <section class="projects">
    <PageTitle title="Projects" />
    <div class="projects__content">
      {renderedProjects.map(({title, link, Content}) => (
        <ProjectTemplate
          title={title}
          link={link}
        >
          <Content />
        </ProjectTemplate>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .projects__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
