---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageTitle from "../../../components/PageTitle.astro";
import Pagination from "../../../components/Pagination.astro";
import ProjectTemplate from "../../../components/ProjectTemplate.astro";
import { ITEMS_PER_PAGE, paginateItems } from "../../../utils/pagination";

type RenderedProject = {
  title: string;
  link: string;
  Content: Awaited<ReturnType<typeof render>>["Content"];
};

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const totalPages = Math.ceil(projects.length / ITEMS_PER_PAGE);

  return Array.from({ length: totalPages - 1 }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const currentPage = Number(Astro.params.page);
const projects: CollectionEntry<"projects">[] = await getCollection("projects");
const renderedProjects: RenderedProject[] = await Promise.all(
  projects.map(async (project) => {
    const { Content } = await render(project);
    return {
      title: project.data.title,
      link: project.data.link,
      Content,
    };
  }),
);
const { items: pageProjects, totalPages } = paginateItems(
  renderedProjects,
  currentPage,
  ITEMS_PER_PAGE,
);
---

<BaseLayout
  title={`Projects - Page ${currentPage}`}
  description="Michael Zhan's projects"
>
  <section class="projects">
    <PageTitle title="Projects" />
    <div class="projects__content">
      {pageProjects.map(({ title, link, Content }) => (
        <ProjectTemplate title={title} link={link}>
          <Content />
        </ProjectTemplate>
      ))}
    </div>
    <Pagination {currentPage} {totalPages} basePath="/projects" />
  </section>
</BaseLayout>

<style>
  .projects__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
