---
import { getCollection } from "astro:content";
import BlogItemTemplate from "../../../components/BlogItemTemplate.astro";
import PageTitle from "../../../components/PageTitle.astro";
import Pagination from "../../../components/Pagination.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { ITEMS_PER_PAGE, paginateItems } from "../../../utils/pagination";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const totalPages = Math.ceil(posts.length / ITEMS_PER_PAGE);

  return Array.from({ length: totalPages - 1 }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const currentPage = Number(Astro.params.page);
const posts = await getCollection("blog");
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const { items: pagePosts, totalPages } = paginateItems(
  posts,
  currentPage,
  ITEMS_PER_PAGE,
);
---

<BaseLayout
  title={`Blog - Page ${currentPage}`}
  description="Michael Zhan's blog posts"
>
  <section class="blog">
    <PageTitle title="Posts" />
    <div class="blog__content">
      {pagePosts.map((post) => (
        <BlogItemTemplate
          title={post.data.title}
          link={`/blog/${post.id}`}
          date={post.data.date}
          description={post.data.description}
        />
      ))}
    </div>
    <Pagination {currentPage} {totalPages} basePath="/blog" />
  </section>
</BaseLayout>

<style>
  .blog__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
