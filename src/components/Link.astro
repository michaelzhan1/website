---
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  content: string | typeof Icon;
  className?: string;
  ariaLabel?: string;
  newTab?: boolean;
}

const { href, content, className, ariaLabel, newTab } = Astro.props;
---

<a href={href} target={newTab ? "_blank" : undefined} rel={newTab ? "noopener noreferrer" : undefined} class={className} aria-label={ariaLabel}>
  {content}
</a>
