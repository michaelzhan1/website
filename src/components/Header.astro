---
import Link from "./Link.astro";
---

<header class="site-header">
  <nav class="site-header__nav" aria-label="Main navigation">
    <ul class="site-header__list">
      <li class="site-header__item">
        <Link
          className="site-header__link"
          href="/"
          content="Home"
          newTab={false}
        />
      </li>
      <li class="site-header__item">
        <Link
          className="site-header__link"
          href="/about"
          content="About"
          newTab={false}
        />
      </li>
      <li class="site-header__item">
        <Link
          className="site-header__link"
          href="/blog"
          content="Blog"
          newTab={false}
        />
      </li>
      <li class="site-header__item">
        <Link
          className="site-header__link"
          href="/projects"
          content="Projects"
          newTab={false}
        />
      </li>
      <li class="site-header__item">
        <Link
          className="site-header__link"
          href="/resume.pdf"
          newTab={true}
          content="Resume"
        />
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    position: sticky;
    top: 0;
    z-index: 100;
    margin: 1.5rem auto;
    padding: 1rem;
    width: min(calc(100% - 2rem), var(--max-page-width));
    background-color: var(--color-background);
    justify-content: flex-end;

    .site-header__nav {
      display: flex;
    }

    .site-header__list {
      display: flex;
      align-items: center;
      gap: 1rem;
      list-style: none;
      font-size: 1.125rem;
    }

    .site-header__link {
      display: inline-block;
      padding: 0.5rem 0.25rem;
      color: var(--color-header-link);
      text-decoration: none;

      &:hover {
        color: var(--color-header-link-hover);
      }
    }

    @media (max-width: 400px) {
      .site-header__list {
        gap: 0.6rem;
        font-size: 1rem;
      }
    }
  }
</style>
