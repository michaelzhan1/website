---
import { Icon } from "astro-icon/components";
import Link from "./Link.astro";
---

<footer class="site-footer">
  <div class="site-footer__label">Contact me:</div>
  <nav class="site-footer__nav" aria-label="Social links">
    <ul class="site-footer__list">
      <li class="site-footer__item">
        <Link
          className="site-footer__link"
          href="mailto:michaelzhan2001@gmail.com"
          ariaLabel="Email"
          content={<Icon name="email" size="1.25rem" />}
          newTab={true}
        />
      </li>
      <li class="site-footer__item">
        <Link
          className="site-footer__link"
          href="https://www.linkedin.com/in/michaelzhan1/"
          ariaLabel="LinkedIn"
          content={<Icon name="linkedin" size="1.25rem" />}
          newTab={true}
        />
      </li>
      <li class="site-footer__item">
        <Link
          className="site-footer__link"
          href="https://www.github.com/michaelzhan1/"
          ariaLabel="GitHub"
          content={<Icon name="github" size="1.25rem" />}
          newTab={true}
        />
      </li>
    </ul>
  </nav>
  <div class="site-footer__copyright">© 2025-2026 Michael Zhan</div>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.125rem;
    min-height: var(--footer-height);
    width: 100%;
    background-color: var(--color-footer);
    color: var(--color-footer-text);

    .site-footer__label {
      font-size: 1rem;
      margin-top: 0.25rem;
    }

    .site-footer__nav {
      display: flex;
    }

    .site-footer__list {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
      list-style: none;
    }

    .site-footer__link {
      color: var(--color-footer-text);

      &:hover {
        color: var(--color-footer-text-hover);
      }
    }

    .site-footer__copyright {
      font-size: 0.75rem;
      margin-bottom: 0.25rem;
    }
  }
</style>
