---
interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
}

const { currentPage, totalPages, basePath } = Astro.props;
const normalizedBasePath = basePath.replace(/\/$/, "");
const pageHref = (page: number) =>
  page === 1 ? `${normalizedBasePath}/` : `${normalizedBasePath}/page/${page}/`;
const hasPreviousPage = currentPage > 1;
const hasNextPage = currentPage < totalPages;
const pages = Array.from({ length: totalPages }, (_, index) => index + 1);
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="Pagination">
    {hasPreviousPage && (
      <a
        class="pagination__link"
        href={pageHref(currentPage - 1)}
        rel="prev"
      >
        Previous
      </a>
    )}

    <ol class="pagination__pages" aria-label="Pages">
      {pages.map((page) => (
        <li>
          {page === currentPage ? (
            <span class="pagination__current" aria-current="page">{page}</span>
          ) : (
            <a class="pagination__link" href={pageHref(page)}>
              {page}
            </a>
          )}
        </li>
      ))}
    </ol>

    {hasNextPage && (
      <a
        class="pagination__link"
        href={pageHref(currentPage + 1)}
        rel="next"
      >
        Next
      </a>
    )}
  </nav>
)}

<style>
  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .pagination > .pagination__link:first-child {
    justify-self: start;
  }

  .pagination__pages {
    display: flex;
    gap: 0.75rem;
    grid-column: 2;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pagination__link {
    color: var(--color-text);

    &:hover {
      color: var(--color-text-hover);
    }
  }

  .pagination > .pagination__link:last-child {
    grid-column: 3;
    justify-self: end;
  }

  .pagination__current {
    font-weight: 700;
  }
</style>